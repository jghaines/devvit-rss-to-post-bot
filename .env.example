# Core feed settings
FEED_URL=./fixtures/sample-rss.xml
TARGET_SUBREDDIT=YourSubreddit
POLL_MINUTES=15
MAX_POSTS_PER_RUN=3
POST_KIND=self
TITLE_PREFIX=[Episode] 
MAX_BODY_CHARS=12000

# Local harness behavior
STATE_FILE=.local-state.json
MAX_DEDUPE_TRACK=500
DRY_RUN=true

# Optional local live-submit credentials (only used by "npm run local:live")
# Create a Reddit "script" app and provide a refresh token with submit scope.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=devvit-rss-to-post-bot/0.1 by u/your_username
