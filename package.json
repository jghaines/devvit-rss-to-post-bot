{
  "name": "rss-post-bot",
  "version": "0.0.0",
  "private": true,
  "description": "Devvit RSS-to-link-post bot with checkpoint tracking and local CLI harness.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "local:test": "node scripts/local-poll.mjs --dry-run",
    "local:test:env": "ENV_FILE=.env.test node scripts/local-poll.mjs --dry-run",
    "local:preview": "node scripts/local-preview.mjs",
    "local:preview:env": "ENV_FILE=.env.test node scripts/local-preview.mjs",
    "local:live": "node scripts/local-poll.mjs --live",
    "build": "node tools/build.mjs",
    "sync:readme": "node scripts/sync-readme-domains.mjs",
    "devvit:playtest": "npx devvit playtest",
    "devvit:upload": "npx devvit upload",
    "release:prod": "npm test && node scripts/devvit-publish-and-tag.mjs"
  },
  "dependencies": {
    "@devvit/reddit": "0.14.2",
    "@devvit/redis": "0.14.2",
    "@devvit/scheduler": "0.14.2",
    "@devvit/server": "0.14.2",
    "@devvit/settings": "0.14.2",
    "@devvit/web": "0.14.2"
  },
  "devDependencies": {
    "devvit": "0.14.2",
    "esbuild": "0.28.2",
    "vitest": "5.0.0"
  },
  "license": "0BSD"
}
